# Public release allowlist: unlisted paths remain local.
/*
!/.gitignore
!/README.md
!/pyproject.toml
!/requirements.txt
!/src/
!/tests/
!/examples/
!/requirements/
!/docs/
!/configs/
!/scripts/
/docs/*
!/docs/public/
/configs/*
!/configs/public/
/scripts/*
!/scripts/check_public_release.py
/requirements/*
!/requirements/locks/
/requirements/locks/*
!/requirements/locks/README.md
!/requirements/locks/qbench-win-cpu-py312-20261028.txt
!/requirements/locks/qbench-win-cpu-py312-20261028.wheels.json
!/requirements/locks/validate_qbench_environment.py
# Teaching example: publish source only.
/examples/**
!/examples/__init__.py
!/examples/transformer_imdb/
!/examples/transformer_imdb/*.py
!/examples/transformer_imdb/requirements.txt
# Caches and secrets at any depth.
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
.env
.env.*
*.pem
*.key
*.p12
*.pfx
# Data, trained models, source reports and archives.
*.dcm
*.dicom
*.xlsx
*.xls
*.csv
*.tsv
*.parquet
*.npz
*.npy
*.pkl
*.pickle
*.joblib
*.pt
*.pth
*.h5
*.hdf5
*.ckpt
*.safetensors
*.ipynb
*.pdf
*.docx
*.zip
*.7z
*.tar
*.gz
*.log
*.png
*.jpg
*.jpeg
*.svg
